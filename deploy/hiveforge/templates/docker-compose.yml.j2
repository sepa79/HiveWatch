services:
  postgres:
    image: postgres:17-alpine
    environment:
      POSTGRES_DB: hive_watch
      POSTGRES_USER: hive_watch
      POSTGRES_PASSWORD: hive_watch
    volumes:
      - hivewatch-postgres-data:/var/lib/postgresql/data

  hive-watch-service:
    image: ghcr.io/sepa79/hivewatch-service:{{ hivewatch_service_image_tag }}
    depends_on:
      - postgres
    ports:
{% if hivewatch_swarm_profile %}
      - target: 8080
        published: {{ hivewatch_http_port }}
        protocol: tcp
        mode: ingress
{% else %}
      - "{{ hivewatch_http_port }}:8080"
{% endif %}
    environment:
      HW_DB_URL: jdbc:postgresql://{{ hivewatch_postgres_host }}:5432/hive_watch
      HW_DB_USER: hive_watch
      HW_DB_PASSWORD: hive_watch

{% if hivewatch_test_profile %}
  nft-01-touchpoint-tomcats:
    image: ghcr.io/sepa79/hivewatch-dummy-tomcat-multi:{{ hivewatch_dummy_image_tag }}
    environment:
      TOMCAT_INSTANCES: payments,services,auth
      TOMCAT_SERVER_LABEL: "NFT-01 / Touchpoint"
      WEBAPPS_PAYMENTS: "PaymentApp1##2.0.0,PaymentApp2##2.0.0,SharedPaymentsApp##2.0.0"
      WEBAPPS_SERVICES: "ServicesApp1##2.0.0,TouchpointGateway##2.0.0,SharedServicesApp##2.0.0"
      WEBAPPS_AUTH: "AuthApp1##2.0.0,SSOConsole##2.0.0,SharedAuthApp##2.0.0"
    ports:
      - "19111:8081"
      - "19112:8082"
      - "19113:8083"

  nft-01-services-tomcats:
    image: ghcr.io/sepa79/hivewatch-dummy-tomcat-multi:{{ hivewatch_dummy_image_tag }}
